# Cognito
COGNITO_EMAILS_FROM=noreply@mail.com.br
COGNITO_EMAILS_REPLY_TO=contact@mail.com.br

# SES
SES_ARN=arn:aws:ses:::identity/mail.com.br

# Route 53
ROUTE53_HOSTED_ZONE_ID=x

# API Gateway Custom Domain
DISABLED_DEFAULT_APIGW_ENDPOINT=true
API_DOMAIN_NAME=api.domain.com.br

# Meals CDN Custom Domain
MEALS_CDN_DOMAIN_NAME=meals-cdn.domain.com.br
MEALS_CDN_CERTIFICATE_ARN=arn:aws:acm:us-east-1:identity:certificate/certificateId

# SNS
MEALS_DLQ_ALARM_EMAIL=contact@mail.com

# Script
SCRIPT_API_URL=endpoint
SCRIPT_TOKEN=token
